# ==========================================
# Git
# ==========================================
.git
.gitignore

# ==========================================
# Docker & Project Config
# ==========================================
# 防止把 Dockerfile 自身和 compose 文件打进镜像
Dockerfile
.dockerignore
docker-compose.yml
docker-compose.*.yml

# ==========================================
# Python Caches & Environments
# ==========================================
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.pytest_cache/
.ipynb_checkpoints/

# ==========================================
# 极其重要：大文件与本地测试残留
# ==========================================
# 忽略本地生成的音频文件（不需要打进镜像）
data/
*.wav
*.flac
*.mp3

# 忽略本地的模型文件（因为我们是在云端或构建时自动下载）
# 如果你本地有 models 文件夹，千万不能打进去，否则构建会卡死！
models/

# ==========================================
# IDE & OS Files
# ==========================================
.idea/
.vscode/
.DS_Store
Thumbs.db
*.log